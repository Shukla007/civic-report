# Server Configuration
PORT=5000

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/civic-report
MONGODB_URI=mongodb://localhost:27017/civic-report

# Optional: if you use a mongodb+srv:// Atlas URI and get
# `querySrv ECONNREFUSED _mongodb._tcp...`, Node's SRV DNS resolver may be using
# a DNS server that refuses SRV queries.
# Set this to a DNS server that works on your network (comma-separated).
# Example: MONGODB_DNS_SERVERS=10.198.193.235
MONGODB_DNS_SERVERS=

# CORS Origins (comma-separated for multiple origins)
# Example: https://your-frontend.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Admin Credentials (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
