# =====================
# Frontend (React)
# =====================
# Create React App only exposes env vars prefixed with REACT_APP_.
#
# Local development:
# REACT_APP_API_URL=http://localhost:5000/api

# Production example (Railway):
REACT_APP_API_URL=https://civic-report-production.up.railway.app/api

# Backend env vars live in `server/.env` (see `server/.env.example`).
